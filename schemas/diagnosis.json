{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiteSenseDiagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_label",
    "category",
    "issue_summary",
    "observations",
    "probable_causes",
    "severity",
    "confidence",
    "safety_hazard",
    "safety_notes",
    "recommended_actions",
    "needs_expert",
    "follow_up_questions"
  ],
  "properties": {
    "object_label": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["equipment", "crop", "structure", "vehicle", "other"]
    },
    "issue_summary": { "type": "string" },
    "observations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "probable_causes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause", "likelihood"],
        "properties": {
          "cause": { "type": "string" },
          "likelihood": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "safety_hazard": { "type": "boolean" },
    "safety_notes": { "type": "string" },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "priority"],
        "properties": {
          "step": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["immediate", "soon", "routine"]
          }
        }
      }
    },
    "needs_expert": { "type": "boolean" },
    "follow_up_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
