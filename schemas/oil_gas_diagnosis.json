{
  "name": "sitesense_oil_gas_diagnosis",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "issue_summary": {
        "type": "string"
      },
      "severity": {
        "type": "string",
        "enum": [
          "Low",
          "Medium",
          "High",
          "Critical"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "observed_conditions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "likely_causes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "immediate_actions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "recommended_next_steps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "safety_notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "work_order_draft": {
        "type": "string"
      },
      "additional_issues": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "asset_type": {
        "type": "string",
        "enum": [
          "wellhead",
          "pipeline",
          "valve",
          "flange",
          "pressure_gauge",
          "tank",
          "containment",
          "separator_or_vessel",
          "compressor_or_pump",
          "signage",
          "site_general",
          "other"
        ]
      },
      "hazard_flags": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "leak_or_stain",
            "corrosion",
            "pressure",
            "h2s_sour_cue",
            "hot_work",
            "containment_breach",
            "missing_signage",
            "ppe_gap",
            "ignition_source",
            "other"
          ]
        }
      },
      "gauge_reading": {
        "type": "string",
        "description": "Only the clearly legible reading with units, otherwise 'not legible' or 'no gauge'."
      },
      "requires_gas_detection": {
        "type": "boolean"
      },
      "regulatory_note": {
        "type": "string"
      }
    },
    "required": [
      "issue_summary",
      "severity",
      "confidence",
      "observed_conditions",
      "likely_causes",
      "immediate_actions",
      "recommended_next_steps",
      "safety_notes",
      "work_order_draft",
      "additional_issues",
      "asset_type",
      "hazard_flags",
      "gauge_reading",
      "requires_gas_detection",
      "regulatory_note"
    ],
    "additionalProperties": false
  }
}
